<Window x:Class="UniversalBatteryOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal Battery Overlay"
        Width="1080"
        Height="760"
        MinWidth="920"
        MinHeight="640"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0D1320" />
            <Setter Property="BorderBrush" Value="#253149" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SmallTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="TinyPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="#111C32" />
            <Setter Property="BorderBrush" Value="#2B3750" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border CornerRadius="30" Padding="22" BorderBrush="#303A52" BorderThickness="1" Margin="0,0,0,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#151A2A" Offset="0" />
                    <GradientStop Color="#0B1220" Offset="0.52" />
                    <GradientStop Color="#24123B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.22" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Universal Battery Overlay" Foreground="#F8FAFC" FontSize="31" FontWeight="Bold" />
                    <TextBlock Text="Realtime wireless battery overlay. Close this window and it keeps running quietly in the tray." Foreground="#A6B0C3" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="Refresh now" Click="RefreshButton_Click" Background="#7C3AED" BorderBrush="#A78BFA" />
                    <Button x:Name="ToggleOverlayButton" Content="Hide overlay" Click="ToggleOverlayButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Dashboard">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="0.75*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="2,0,2,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Devices" Style="{StaticResource SmallTitle}" />
                                    <TextBlock Text="Clean cards for every detected reader. The overlay only shows useful rows with a real percentage." Style="{StaticResource Muted}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource TinyPill}" VerticalAlignment="Center">
                                    <TextBlock Text="Realtime 1s" Foreground="#C4B5FD" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <ListBox x:Name="DevicesGrid"
                                     Grid.Row="1"
                                     Foreground="#F8FAFC"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,10" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="22" Padding="14" BorderBrush="#2A3650" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#111827" Offset="0" />
                                                    <GradientStop Color="#0A1020" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="46" Height="46" CornerRadius="16" Background="#192235" BorderBrush="#3B4A66" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeDisplay}" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Name}" Foreground="#9AA7BD" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding CleanStatusDisplay}" Foreground="#7DD3FC" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Border CornerRadius="18" Background="#182235" BorderBrush="#384761" BorderThickness="1" Padding="15,8" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding BatteryWithChargingDisplay}" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding LastUpdatedDisplay}" Foreground="#64748B" FontSize="10" HorizontalAlignment="Right" Margin="0,6,3,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Live overlay preview" Style="{StaticResource SmallTitle}" />
                                <TextBlock Text="This mirrors the compact overlay style: less padding, clean rows, no extra text." Style="{StaticResource Muted}" Margin="0,5,0,12" />
                                <Border x:Name="PreviewChrome" CornerRadius="13" Padding="5" Background="#C90B1020" BorderBrush="#344054" BorderThickness="1" HorizontalAlignment="Left">
                                    <ItemsControl x:Name="PreviewItems" FontSize="14">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="9" Background="#161E293B" Padding="7,2" Margin="0,1" MinWidth="112">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TypeDisplay}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,14,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding BatteryWithChargingDisplay}" Foreground="#F8FAFC" FontWeight="Bold" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Quick actions" Style="{StaticResource SmallTitle}" />
                                <TextBlock Text="The X button hides this window to tray. Use Exit only when you really want to stop monitoring." Style="{StaticResource Muted}" Margin="0,5,0,10" />
                                <Button Content="Hide to tray" Click="MinimizeButton_Click" />
                                <Button Content="Open custom readers folder" Click="OpenReadersFolder_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Overlay">
                <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Position" Style="{StaticResource SmallTitle}" />
                                    <TextBlock Text="Choose the monitor and exact corner for the compact overlay." Style="{StaticResource Muted}" Margin="0,5,0,10" />
                                    <Label Content="Monitor" />
                                    <ComboBox x:Name="MonitorCombo" />
                                    <Label Content="Position" />
                                    <ComboBox x:Name="PositionCombo" />
                                    <UniformGrid Columns="2">
                                        <StackPanel>
                                            <Label Content="Offset X" />
                                            <TextBox x:Name="OffsetXBox" />
                                        </StackPanel>
                                        <StackPanel>
                                            <Label Content="Offset Y" />
                                            <TextBox x:Name="OffsetYBox" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Compact spacing" Style="{StaticResource SmallTitle}" />
                                    <TextBlock Text="Use these to remove the big padding from the top-left display." Style="{StaticResource Muted}" Margin="0,5,0,10" />
                                    <UniformGrid Columns="2">
                                        <StackPanel>
                                            <Label Content="Outer padding" />
                                            <TextBox x:Name="OverlayPaddingBox" />
                                        </StackPanel>
                                        <StackPanel>
                                            <Label Content="Minimum width" />
                                            <TextBox x:Name="MinWidthBox" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2">
                                        <StackPanel>
                                            <Label Content="Row padding X" />
                                            <TextBox x:Name="RowPaddingXBox" />
                                        </StackPanel>
                                        <StackPanel>
                                            <Label Content="Row padding Y" />
                                            <TextBox x:Name="RowPaddingYBox" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2">
                                        <StackPanel>
                                            <Label Content="Row spacing" />
                                            <TextBox x:Name="RowSpacingBox" />
                                        </StackPanel>
                                        <StackPanel>
                                            <Label Content="Corner radius" />
                                            <TextBox x:Name="CornerRadiusBox" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Appearance" Style="{StaticResource SmallTitle}" />
                                    <TextBlock Text="Keep it elegant and readable without taking space on screen." Style="{StaticResource Muted}" Margin="0,5,0,10" />
                                    <UniformGrid Columns="2">
                                        <StackPanel>
                                            <Label Content="Text size" />
                                            <TextBox x:Name="FontSizeBox" />
                                        </StackPanel>
                                        <StackPanel>
                                            <Label Content="Overlay opacity" />
                                            <TextBox x:Name="OpacityBox" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <Label Content="Background opacity" />
                                    <TextBox x:Name="BgOpacityBox" />
                                    <CheckBox x:Name="ShowOverlayBackgroundCheck" Content="Show glass background" />
                                    <CheckBox x:Name="ShowOverlayShadowCheck" Content="Show soft shadow" />
                                    <CheckBox x:Name="ClickThroughCheck" Content="Click-through overlay" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Preview" Style="{StaticResource SmallTitle}" />
                                    <TextBlock Text="Save after changing spacing or opacity, then the real overlay updates instantly." Style="{StaticResource Muted}" Margin="0,5,0,12" />
                                    <Border CornerRadius="13" Padding="5" Background="#C90B1020" BorderBrush="#344054" BorderThickness="1" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <Border CornerRadius="9" Background="#161E293B" Padding="7,2" Margin="0,1" MinWidth="112">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Mouse" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,14,0" />
                                                    <TextBlock Grid.Column="1" Text="40%" Foreground="#F8FAFC" FontWeight="Bold" />
                                                </Grid>
                                            </Border>
                                            <Border CornerRadius="9" Background="#161E293B" Padding="7,2" Margin="0,1" MinWidth="112">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Headset" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,14,0" />
                                                    <TextBlock Grid.Column="1" Text="⚡ 55%" Foreground="#F8FAFC" FontWeight="Bold" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Devices">
                <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Supported device strategy" Style="{StaticResource SmallTitle}" />
                                <TextBlock Text="The app tries Windows battery APIs, Bluetooth/PnP properties, standard HID battery reports, known device readers and custom plugins. It never sends active commands to unknown keyboards." Style="{StaticResource Muted}" Margin="0,5,0,12" />
                                <CheckBox x:Name="EnableRazerDirectCheck" Content="Enable direct readers for supported devices" />
                                <CheckBox x:Name="EnableUniversalHidCheck" Content="Enable universal Windows HID battery reader" />
                                <CheckBox x:Name="ShowLaptopCheck" Content="Show laptop/system battery" />
                                <CheckBox x:Name="ShowUnknownCheck" Content="Show detected devices without battery percentage in the app" />
                                <Button Content="Open custom readers folder" Click="OpenReadersFolder_Click" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Extra device hints" Style="{StaticResource SmallTitle}" />
                                <TextBlock Text="Add names or VID/PID strings for devices you want the app to keep visible and classify." Style="{StaticResource Muted}" Margin="0,5,0,10" />
                                <ListBox x:Name="HintsList" Height="180" Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#273244" Margin="4" />
                                <TextBox x:Name="HintBox" ToolTip="Example: Razer, G733, QwertyKey, VID_1234&amp;PID_ABCD" />
                                <UniformGrid Columns="2">
                                    <Button Content="Add hint" Click="AddHint_Click" />
                                    <Button Content="Remove selected" Click="RemoveHint_Click" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Realtime" Style="{StaticResource SmallTitle}" />
                                <TextBlock Text="Fast polling stays protected so a slow reader cannot overlap itself and freeze input." Style="{StaticResource Muted}" Margin="0,5,0,10" />
                                <Label Content="Refresh every N seconds" />
                                <TextBox x:Name="RefreshSecondsBox" />
                                <Label Content="Low battery alert below (%)" />
                                <TextBox x:Name="LowBatteryBox" />
                                <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Tray behavior" Style="{StaticResource SmallTitle}" />
                                <TextBlock Text="Closing this window hides it to the tray. The overlay and battery monitor keep running in the background." Style="{StaticResource Muted}" Margin="0,5,0,12" />
                                <Button Content="Hide to tray" Click="MinimizeButton_Click" />
                                <Button Content="Refresh now" Click="RefreshButton_Click" />
                                <Button Content="Exit completely" Click="ExitButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#0D1320" CornerRadius="24" Padding="13" BorderBrush="#253149" BorderThickness="1" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Realtime monitoring is running. Close the window to keep it in the tray." Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ApplyButton" Content="Save changes" Click="ApplyButton_Click" Background="#7C3AED" BorderBrush="#A78BFA" />
                    <Button x:Name="MinimizeButton" Content="Hide to tray" Click="MinimizeButton_Click" />
                    <Button x:Name="ExitButton" Content="Exit" Click="ExitButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

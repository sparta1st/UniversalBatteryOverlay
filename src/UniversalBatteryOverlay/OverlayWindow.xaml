<Window x:Class="UniversalBatteryOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight">
    <Border x:Name="RootBorder"
            CornerRadius="13"
            BorderBrush="#344054"
            BorderThickness="1"
            Padding="5"
            SnapsToDevicePixels="True">
        <Border.Background>
            <SolidColorBrush Color="#D80B1020" />
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.34" />
        </Border.Effect>
        <ItemsControl x:Name="Items">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="9"
                            Background="#161E293B"
                            Padding="{Binding RowPadding, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="{Binding RowMargin, RelativeSource={RelativeSource AncestorType=Window}}"
                            MinWidth="{Binding RowMinWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TypeDisplay}"
                                       Foreground="#F8FAFC"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding BatteryWithChargingDisplay}"
                                       Foreground="#F8FAFC"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
